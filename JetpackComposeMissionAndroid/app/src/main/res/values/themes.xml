<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.JetpackComposeMissionAndroid" parent="android:Theme.Material.Light.NoActionBar" />

    <!--    Transparent Launch Theme to Remove Default Splash  -->
    <style name="Theme.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">
            @android:color/transparent
        </item>
        <item name="android:windowDisablePreview">
            true
        </item>
    </style>

    <!--    Splash API   -->
    <style name="Theme.MySplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">
            @android:color/black
        </item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">
            @drawable/dog
        </item>
        <item name="postSplashScreenTheme">
            @style/Theme.JetpackComposeMissionAndroid
        </item>
    </style>
</resources>
